# Copy to .env and fill in. Never commit .env.
AZURE_RESOURCE=your-foundry-resource-name
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini
AZURE_OPENAI_API_KEY=
REALTIME_VOICE=marin
PORT=3001

# Optional tuning
# Input transcription model for live captions (must be available on your resource).
REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
# Caption language hint (ISO-639-1). Empty = auto-detect (more misheard first turns).
REALTIME_TRANSCRIPTION_LANGUAGE=en
# Turn detection: semantic (default, resists speaker echo/noise) or server (snappier, echo-prone).
REALTIME_VAD=semantic
# Input noise reduction: far_field (laptop/kiosk mic, default), near_field (headset) or none.
REALTIME_NOISE_REDUCTION=far_field
# Server VAD only: silence before it ends the user's turn. Lower = snappier, more cut-offs.
REALTIME_SILENCE_MS=400
